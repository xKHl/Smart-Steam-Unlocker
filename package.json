{
  "name": "smart-steam-unlocker",
  "version": "0.2.7",
  "description": "A smart local Steam Achievement Unlocker desktop application with delay timer logic",
  "author": "Khalid Alotaibi",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n \"VITE,ELECTRON\" -c \"cyan.bold,yellow.bold\" \"vite\" \"npm run electron:dev\"",
    "dev:diagnostics": "concurrently -k -n \"VITE,ELECTRON\" -c \"cyan.bold,yellow.bold\" \"vite\" \"npm run electron:dev:diagnostics\"",
    "electron:dev": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "electron:dev:diagnostics": "wait-on http://localhost:5173 && cross-env NODE_ENV=development SSU_DIAGNOSTICS=1 electron . --enable-diagnostics",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "steamworks.js": "^0.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.7",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.smartsteam.unlocker",
    "productName": "Smart Steam Unlocker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "steam_appid.txt",
      "package.json",
      "node_modules/steamworks.js/**/*"
    ],
    "extraResources": [
      {
        "from": "steam_appid.txt",
        "to": "."
      }
    ],
    "win": {
      "target": "nsis",
      "sign": null,
      "signingHashAlgorithms": null
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
